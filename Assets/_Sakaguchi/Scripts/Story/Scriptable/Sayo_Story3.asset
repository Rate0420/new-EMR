  - text: "\u4F11\u65E5\u306E\u663C\u4E0B\u304C\u308A\u3002\r\n\u4FFA\u306F\u99C5\u524D\u306E\u9AD8\u7D1A\u30B9\u30A4\u30FC\u30C4\u5E97\u306E\u884C\u5217\u306B\u4E26\u3093\u3067\u3044\u305F\u3002\u96A3\u306B\u306F\u3001\u5E3D\u5B50\u3092\u6DF1\u304F\u88AB\u308A\u3001\u4FFA\u306E\u80CC\u4E2D\u306B\u534A\u5206\u96A0\u308C\u308B\u3088\u3046\u306B\u3057\u3066\u7ACB\u3063\u3066\u3044\u308B\u5C0F\u591C\u304C\u3044\u308B\u3002"
