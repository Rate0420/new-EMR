  entries:
  - text: "\u305B\u3001\u5148\u8F29\u2026\u2026\u3002\u4E3B\u541B\u306A\u3093\u3060\u304B\u3089\u3001\u81E3\u4E0B\u3078\u306E\u8912\u7F8E\u306F\u2026\u2026\u5F53\u7136\u306E\u7FA9\u52D9\u3067\u3059\u3088\u306D\u2026\u2026\uFF1F\r"
