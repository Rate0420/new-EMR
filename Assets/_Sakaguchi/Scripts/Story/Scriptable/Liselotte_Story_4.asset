  - text: "\u606F\u304C\u8A70\u307E\u308B\u3088\u3046\u306A\u90E8\u5C4B\u304B\u3089\u9003\u3052\u51FA\u3059\u3088\u3046\u306B\u3001\u4FFA\u306F\u6BCE\u6669\u3042\u3066\u3082\u306A\u304F\u591C\u306E\u8857\u3092\u5F77\u5FA8\u3046\u3088\u3046\u306B\u306A\u3063\u3066\u3044\u305F\u3002\r\n"
