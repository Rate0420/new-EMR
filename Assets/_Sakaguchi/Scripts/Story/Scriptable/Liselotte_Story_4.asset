  entries:
  - text: "\u3042\u306E\u65E5\u3001\u90E8\u5C4B\u306B\u91CD\u305F\u3044\u6C88\u9ED9\u3092\u6B8B\u3057\u3066\u30D9\u30E9\u30F3\u30C0\u3078\u51FA\u3066\u884C\u3063\u305F\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6\u3002\r\n\u305D\u308C\u304B\u3089\u306E\u6570\u65E5\u9593\u3001\u56DB\u7573\u534A\u306E\u7A7A\u6C17\u306F\u91DD\u306E\u7B75\u306E\u3088\u3046\u306B\u5F35\u308A\u8A70\u3081\u3066\u3044\u305F\u3002"
