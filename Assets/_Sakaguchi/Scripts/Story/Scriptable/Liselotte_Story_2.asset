  - text: "\u7D50\u5C40\u3001\u3042\u306E\u5F8C\u81EA\u5BA4\u3078\u9023\u308C\u3066\u5E30\u3063\u3066\u3057\u307E\u3063\u305F\u3002\r\n\u6E6F\u6C17\u3092\u7ACB\u3066\u308B\u767A\u6CE1\u30B9\u30C1\u30ED\u30FC\u30EB\u306E\u5BB9\u5668\u3092\u62B1\u3048\u3001\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6\u306F\u76EE\u3092\u8F1D\u304B\u305B\u306A\u304C\u3089\u731B\u70C8\u306A\u52E2\u3044\u3067\u9EBA\u3092\u3059\u3059\u3063\u3066\u3044\u305F\u3002\r\n\u3059\u3067\u306B\u8DB3\u5143\u306B\u306F\u3001\u7A7A\u306B\u306A\u3063\u305F\u30AB\u30C3\u30D7\u9EBA\u306E\u5BB9\u5668\u304C\u4E94\u3064\u8EE2\u304C\u3063\u3066\u3044\u308B\u3002\r\n"
