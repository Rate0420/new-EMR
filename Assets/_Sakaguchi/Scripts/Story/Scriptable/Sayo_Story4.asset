  - text: "\u3048\u3001\u3048\u3078\u3078\u2026\u2026\u3002\u3084\u3063\u3071\u308A\u5148\u8F29\u306F\u3001\u79C1\u304C\u3044\u306A\u3044\u3068\u30C0\u30E1\u3067\u3059\u306D\u3047\u2026\u2026\r"
