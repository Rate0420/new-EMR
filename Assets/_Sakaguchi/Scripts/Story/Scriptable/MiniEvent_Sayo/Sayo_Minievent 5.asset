  entries:
  - text: "\u5C0F\u591C\u3068\u99C5\u524D\u3092\u6B69\u3044\u3066\u3044\u308B\u3068\u3001\u65B0\u3057\u3044\u30AF\u30EC\u30FC\u30D7\u5C4B\u306E\u524D\u306B\u9577\u86C7\u306E\u5217\u304C\u3067\u304D\u3066\u3044\u305F\u3002"
