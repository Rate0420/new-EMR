  - text: "\u5C0F\u591C\u304C\u4FFA\u306E\u670D\u306E\u88FE\u3092\u5F15\u3063\u5F35\u308A\u3001\u4E0A\u76EE\u9063\u3044\u3067\u8A34\u3048\u304B\u3051\u3066\u304F\u308B\u3002"
