    bgm: {fileID: 0}
    se: {fileID: 0}
    voice: {fileID: 0}
    scEffect: 0
    nextScene: 
    nextIndex: 0
    choices: []
  - text: "\u6570\u9031\u9593\u306E\u9577\u5927\u306A\u4EA4\u6E09\u3068\u88CF\u5DE5\u4F5C\u306E\u672B\u3001\u4FFA\u306E\u63D0\u6848\u306F\u91CC\u306E\u4E0A\u5C64\u90E8\u306B\u53D7\u3051\u5165\u308C\u3089\u308C\u305F\u3002"
