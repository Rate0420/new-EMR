  entries:
  - text: "\u4FFA\u306F\u5C0F\u591C\u306E\u80CC\u4E2D\u306B\u624B\u3092\u4F38\u3070\u3057\u3001\u5F7C\u5973\u3092\u5236\u6B62\u3057\u305F\u3002"
