    choices: []
  - text: "\u305D\u3057\u3066\u3001\u8FFD\u624B\u306E\u7537\u305F\u3061\u306B\u5411\u304B\u3063\u3066\u3001\u83AB\u5927\u306A\u6B8B\u9AD8\u304C\u8868\u793A\u3055\u308C\u3066\u3044\u308B\u30B9\u30DE\u30DB\u306E\u753B\u9762\u3092\u7A81\u304D\u3064\u3051\u305F\u3002\r"
    charName: none
    char1Sprite: {fileID: 0}
    char1OffsetX: 0
    char1OffsetY: 0
    char2Sprite: {fileID: 0}
    char2OffsetX: 0
    char2OffsetY: 0
