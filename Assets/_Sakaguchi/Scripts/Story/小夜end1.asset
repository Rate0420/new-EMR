    scEffect: 0
    nextScene: 
    nextIndex: 0
    choices: []
  - text: "\u5F7C\u5973\u3092\u5931\u3046\u306E\u306F\u91CC\u306B\u3068\u3063\u3066\u3082\u75DB\u624B\u3067\u3042\u308A\u3001\u4F55\u3088\u308A\u4FFA\u304C\u63D0\u793A\u3057\u305F\u300C\u8CC7\u91D1\u6E90\u300D\u306F\u3001\u73FE\u4EE3\u306E\u88CF\u793E\u4F1A\u3092\u751F\u304D\u308B\u5F7C\u3089\u306B\u3068\u3063\u3066\u5589\u304B\u3089\u624B\u304C\u51FA\u308B\u307B\u3069\u9B45\u529B\u7684\u306A\u63D0\u6848\u3060\u3063\u305F\u3002"
    charName: none
    char1Sprite: {fileID: 0}
    char1OffsetX: 0
