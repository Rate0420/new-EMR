    choices: []
  - text: "\u5927\u5B66\u306E\u30D7\u30EC\u30CF\u30D6\u90E8\u5BA4\u3002\u5C0F\u591C\u306F\u3044\u3064\u3082\u306E\u30D1\u30A4\u30D7\u6905\u5B50\u306B\u5EA7\u308A\u306A\u304C\u3089\u3001\u4E0A\u76EE\u9063\u3044\u3067\u4FFA\u3092\u898B\u3066\u304D\u305F\u3002"
