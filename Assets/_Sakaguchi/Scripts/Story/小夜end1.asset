    nextIndex: 0
    choices: []
  - text: "\u5C0F\u591C\u306F\u5C11\u3057\u7167\u308C\u304F\u3055\u305D\u3046\u306B\u7B11\u3044\u3001\u4FFA\u304C\u8CB7\u3063\u3066\u304D\u305F\u9AD8\u7D1A\u30DE\u30AB\u30ED\u30F3\u306B\u624B\u3092\u4F38\u3070\u3057\u305F\u3002"
