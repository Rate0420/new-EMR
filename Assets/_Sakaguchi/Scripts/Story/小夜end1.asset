    scEffect: 0
    nextScene: 
    nextIndex: 0
    choices: []
  - text: "\u300C\u3044\u3044\u3093\u3060\u3088\u3002\u304A\u524D\u306E\u305D\u306E\u539A\u304B\u307E\u3057\u3044\u6027\u683C\u3082\u3001\u4FFA\u306E\u501F\u91D1\u53D6\u308A\u3092\u5439\u3063\u98DB\u3070\u3059\u5F37\u3055\u3082\u3001\u5168\u90E8\u3072\u3063\u304F\u308B\u3081\u3066\u4FFA\u304C\u9762\u5012\u898B\u3066\u3084\u308B\u3063\u3066\u6C7A\u3081\u305F\u3093\u3060\u304B\u3089\u306A\u300D"
