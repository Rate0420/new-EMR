    choices: []
  - text: "\u300C\u2026\u2026\u3048\u3078\u3078\u3001\u307E\u3041\u3001\u3053\u306E\u95A2\u4FC2\u3082\u2026\u2026\u3044\u3044\u3067\u3059\u3051\u3069\u2026\u2026\u300D"
