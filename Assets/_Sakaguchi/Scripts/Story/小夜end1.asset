    voice: {fileID: 0}
    scEffect: 0
    nextScene: 
    nextIndex: 0
    choices: []
  - text: "\u300C\u5F85\u3066\u3002\u5C0F\u591C\u3092\u91CC\u306E\u4EFB\u52D9\u304B\u3089\u89E3\u653E\u3057\u308D\u3068\u306F\u8A00\u308F\u306A\u3044\u3002\u3060\u304C\u3001\u5F7C\u5973\u306E\u300E\u8B77\u885B\u5BFE\u8C61\u300F\u3068\u3057\u3066\u4FFA\u3092\u91CC\u306B\u96C7\u308F\u305B\u308D\u300D"
    charName: none
    char1Sprite: {fileID: 0}
    char1OffsetX: 0
    char1OffsetY: 0
    char2Sprite: {fileID: 0}
    char2OffsetX: 0
    char2OffsetY: 0
    bgSprite: {fileID: 0}
    bgm: {fileID: 0}
    se: {fileID: 0}
    voice: {fileID: 0}
    scEffect: 0
    nextScene: 
    nextIndex: 0
    choices: []
  - text: "\u300C\u4FFA\u306B\u306F\u83AB\u5927\u306A\u8CC7\u91D1\u304C\u3042\u308B\u3002\u91CC\u306E\u904B\u55B6\u8CC7\u91D1\u3001\u4EFB\u52D9\u306E\u88CF\u5DE5\u4F5C\u8CBB\u3001\u306A\u3093\u3067\u3082\u4FFA\u304C\u51FA\u3057\u3066\u3084\u308B\u3002\u305D\u306E\u4EE3\u308F\u308A\u3001\u5C0F\u591C\u3092\u4FFA\u306E\u5C02\u5C5E\u306E\u5FCD\u3068\u3057\u3066\u6B63\u5F0F\u306B\u8A8D\u3081\u308D\u300D"
    charName: none
    char1Sprite: {fileID: 0}
    char1OffsetX: 0
    char1OffsetY: 0
    char2Sprite: {fileID: 0}
    char2OffsetX: 0
    char2OffsetY: 0
    bgSprite: {fileID: 0}
    bgm: {fileID: 0}
    se: {fileID: 0}
    voice: {fileID: 0}
    scEffect: 0
    nextScene: 
    nextIndex: 0
    choices: []
  - text: "\u7537\u305F\u3061\u306F\u9854\u3092\u898B\u5408\u308F\u305B\u305F\u3002\u5C0F\u591C\u306F\u7532\u8CC0\u306E\u7531\u7DD2\u3042\u308B\u5BB6\u67C4\u3067\u3042\u308A\u3001\u305D\u306E\u30DD\u30C6\u30F3\u30B7\u30E3\u30EB\u306F\u91CC\u3067\u3082\u968F\u4E00\u3002"
